# ==============================================================================
# e-Kisan Krishi Samridhi - Environment Configuration
# NOTE: Never commit sensitive API keys to GitHub / public repositories.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Groq Cloud AI Configuration (https://console.groq.com/keys)
# Get your free ultra-fast LLM / Vision API key from Groq Console.
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 2. Supabase Cloud Database Configuration (https://supabase.com)
# Create a free project at supabase.com and paste your Project URL and API Key
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key

# Optional direct PostgreSQL connection URL for Supabase Pooler
# DATABASE_URL=postgresql://postgres.yourproject:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# 3. Server Configuration
# ------------------------------------------------------------------------------
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development
